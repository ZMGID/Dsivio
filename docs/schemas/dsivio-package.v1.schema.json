{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "dsivio market package v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "id",
    "version",
    "name",
    "summary",
    "categoryIds",
    "compatibility",
    "notices",
    "welcome",
    "inputHint",
    "verification"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
    },
    "version": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 24
    },
    "summary": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80
    },
    "categoryIds": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 64,
        "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "compatibility": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "minAppVersion",
        "platforms"
      ],
      "properties": {
        "minAppVersion": {
          "type": "string",
          "minLength": 1,
          "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"
        },
        "platforms": {
          "type": "array",
          "items": {
            "enum": [
              "windows-x64",
              "windows-arm64",
              "macos-x64",
              "macos-arm64"
            ]
          },
          "minItems": 1,
          "uniqueItems": true
        }
      }
    },
    "notices": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 80
      },
      "minItems": 0,
      "maxItems": 3
    },
    "welcome": {
      "type": "string",
      "minLength": 1,
      "maxLength": 140
    },
    "inputHint": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100
    },
    "verification": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "platform",
          "dsivioVersion",
          "verifiedAt",
          "record"
        ],
        "properties": {
          "platform": {
            "enum": [
              "windows-x64",
              "windows-arm64",
              "macos-x64",
              "macos-arm64"
            ]
          },
          "dsivioVersion": {
            "type": "string",
            "minLength": 1,
            "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"
          },
          "verifiedAt": {
            "type": "string",
            "minLength": 1,
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
          },
          "record": {
            "type": "string",
            "minLength": 1,
            "pattern": "^[A-Za-z0-9_-]+(?:/[A-Za-z0-9_-]+)*(?:\\.[A-Za-z0-9_-]+)?$"
          }
        }
      },
      "minItems": 0
    },
    "icon": {
      "type": "string",
      "pattern": "^assets/[^\\\\]+\\.(svg|png|webp|jpg|jpeg)$"
    }
  }
}

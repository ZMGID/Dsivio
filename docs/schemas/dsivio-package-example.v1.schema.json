{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "dsivio package conversation example v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "messages"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "messages": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "role",
          "text"
        ],
        "properties": {
          "role": {
            "enum": [
              "user",
              "assistant"
            ]
          },
          "text": {
            "type": "string",
            "minLength": 1,
            "maxLength": 160
          },
          "attachments": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "type",
                "label",
                "path"
              ],
              "properties": {
                "type": {
                  "enum": [
                    "image",
                    "video",
                    "file"
                  ]
                },
                "label": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 40
                },
                "path": {
                  "type": "string",
                  "minLength": 1,
                  "pattern": "^assets/(?:[A-Za-z0-9_-]+/)*[A-Za-z0-9_-]+\\.[A-Za-z0-9_-]+$"
                },
                "poster": {
                  "type": "string",
                  "minLength": 1,
                  "pattern": "^assets/(?:[A-Za-z0-9_-]+/)*[A-Za-z0-9_-]+\\.[A-Za-z0-9_-]+$"
                }
              },
              "allOf": [
                {
                  "if": {
                    "required": [
                      "poster"
                    ],
                    "properties": {
                      "poster": {}
                    }
                  },
                  "then": {
                    "properties": {
                      "type": {
                        "const": "video"
                      }
                    }
                  }
                }
              ]
            },
            "minItems": 0,
            "maxItems": 3
          }
        }
      },
      "minItems": 2,
      "maxItems": 6
    }
  }
}

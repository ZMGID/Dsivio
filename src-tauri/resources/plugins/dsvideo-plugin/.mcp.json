{
  "mcpServers": {
    "comfy-mcp": {
      "command": "${DSVIDEO_PYTHON}",
      "args": [
        "-s",
        "-B",
        "${PLUGIN_ROOT}/scripts/mcp_comfy.py"
      ],
      "env": {
        "DSVIDEO_RUNTIME_ROOT": "${DSVIDEO_RUNTIME_ROOT}",
        "PYTHONPATH": "${DSVIDEO_RUNTIME_ROOT}/python-packages",
        "PYTHONNOUSERSITE": "1",
        "PYTHONUTF8": "1",
        "PYTHONIOENCODING": "utf-8",
        "PYTHONHOME": "",
        "PATH": "${DSVIDEO_RUNTIME_PATH}"
      }
    },
    "video-analyzer": {
      "command": "${DSVIDEO_NODE}",
      "args": [
        "${DSVIDEO_RUNTIME_ROOT}/analyzer/node_modules/mcp-video-analyzer/dist/index.js"
      ],
      "env": {
        "DSVIDEO_RUNTIME_ROOT": "${DSVIDEO_RUNTIME_ROOT}",
        "PATH": "${DSVIDEO_RUNTIME_PATH}",
        "PYTHONPATH": "${DSVIDEO_RUNTIME_ROOT}/python-packages",
        "PYTHONNOUSERSITE": "1",
        "PYTHONUTF8": "1",
        "PYTHONIOENCODING": "utf-8",
        "PYTHONHOME": ""
      }
    }
  }
}

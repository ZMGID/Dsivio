{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "dsivio",
  "version": "1.0.1",
  "identifier": "com.zmair.kivio",
  "build": {
    "beforeDevCommand": "npm run build:video-runtime && npm run dev:ui",
    "beforeBuildCommand": "npm run build:video-runtime && npm run build:ui",
    "devUrl": "http://localhost:5713",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [],
    "macOSPrivateApi": true,
    "security": { "assetProtocol": { "enable": true, "scope": ["$APPDATA/comfy-tasks/**", "$APPDATA/media-tasks/**", "$APPDATA/video-studio/outputs/**"] } }
  },
  "bundle": {
    "active": true,
    "targets": [
      "dmg",
      "msi",
      "nsis"
    ],
    "externalBin": [
      "binaries/kivio-ocr-helper"
    ],
    "resources": {
      "resources/skills": "skills",
      "../docs/licenses": "licenses",
      "resources/image-studio": "image-studio",
      "resources/video-studio": "video-studio",
      "resources/plugins/dsvideo-plugin": "plugins/dsvideo-plugin",
      "resources/plugins/market-companions": "plugins/market-companions",
      "resources/video-runtime": "video-runtime"
    },
    "windows": {
      "nsis": {
        "installerIcon": "icons/icon.ico",
        "installMode": "currentUser"
      }
    },
    "macOS": {
      "infoPlist": "Info.plist"
    },
    "icon": [
      "icons/icon.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}

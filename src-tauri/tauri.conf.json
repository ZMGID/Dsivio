{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "dsivio",
  "version": "1.0.1",
  "identifier": "com.zmair.kivio",
  "build": {
    "beforeDevCommand": "npm run build:video-runtime && npm run dev:ui",
    "beforeBuildCommand": "npm run build:video-runtime && npm run build:ui",
    "devUrl": "http://localhost:5713",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "dsivio",
        "width": 392,
        "height": 152,
        "resizable": true,
        "decorations": false,
        "transparent": true,
        "shadow": false,
        "visibleOnAllWorkspaces": true,
        "create": false,
        "skipTaskbar": true,
        "visible": false
      }
    ],
    "macOSPrivateApi": true
  },
  "bundle": {
    "active": true,
    "targets": [
      "dmg",
      "msi",
      "nsis"
    ],
    "resources": {
      "resources/skills": "skills",
      "resources/plugins": "plugins",
      "resources/video-runtime": "video-runtime",
      "resources/video-studio": "video-studio",
      "../docs/licenses": "licenses"
    },
    "windows": {
      "nsis": {
        "installerIcon": "icons/icon.ico",
        "installMode": "currentUser"
      }
    },
    "macOS": {
      "infoPlist": "Info.plist"
    },
    "icon": [
      "icons/icon.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}

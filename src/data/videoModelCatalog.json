{
  "schemaVersion": 1,
  "verifiedAt": "2026-09-21",
  "protocols": {
    "minimax_h3": {
      "label": "MiniMax H3 (V2)",
      "baseUrl": "https://api.minimax.cn",
      "createPath": "/v2/video_generation",
      "queryPath": "/v2/query/video_generation/{id}",
      "auth": "bearer",
      "headers": {},
      "sources": [
        "https://platform.minimaxi.com/docs/api-reference/video-generation-v2-create"
      ],
      "notes": "H3 与 Hailuo 使用不同协议；H3 必须提供 duration、resolution。"
    },
    "minimax_hailuo": {
      "label": "MiniMax Hailuo (V1)",
      "baseUrl": "https://api.minimax.io/v1",
      "createPath": "/video_generation",
      "queryPath": "/query/video_generation?task_id={id}",
      "auth": "bearer",
      "headers": {},
      "sources": [
        "https://platform.minimax.io/docs/api-reference/video-generation-t2v"
      ],
      "notes": "成功后返回 file_id，需再调用 files/retrieve 获取下载地址。"
    },
    "seedance": {
      "label": "Volcengine Seedance",
      "baseUrl": "https://ark.cn-beijing.volces.com/api/v3",
      "createPath": "/contents/generations/tasks",
      "queryPath": "/contents/generations/tasks/{id}",
      "auth": "bearer",
      "headers": {},
      "sources": [
        "https://docs.volcengine.com/docs/ark/create-video-generation-task-api?lang=zh",
        "https://github.com/volcengine/volcengine-python-sdk/blob/master/volcenginesdkarkruntime/resources/content_generation/tasks.py",
        "https://docs.volcengine.com/docs/ark/model-release-announcement?lang=zh"
      ],
      "notes": "使用方舟 API Key 与已开通的模型 ID；支持自定义推理接入点 ID。"
    },
    "xai_video": {
      "label": "Grok Imagine Video",
      "baseUrl": "https://api.x.ai/v1",
      "createPath": "/videos/generations",
      "queryPath": "/videos/{id}",
      "auth": "bearer",
      "headers": {},
      "sources": [
        "https://docs.x.ai/developers/model-capabilities/video/generation"
      ],
      "notes": "参考图、首尾帧与编辑有不同限制；输出链接有时效。"
    },
    "veo": {
      "label": "Google Veo",
      "baseUrl": "https://generativelanguage.googleapis.com/v1beta",
      "createPath": "/models/{model}:predictLongRunning",
      "queryPath": "/{id}",
      "auth": "google",
      "headers": {},
      "sources": [
        "https://ai.google.dev/gemini-api/docs/veo"
      ],
      "notes": "使用 Gemini API 的长任务协议；操作名称包含 models/.../operations/...，下载需 API Key。"
    },
    "wan": {
      "label": "Alibaba Wan 2.7",
      "baseUrl": "https://dashscope.aliyuncs.com/api/v1",
      "createPath": "/services/aigc/video-generation/video-synthesis",
      "queryPath": "/tasks/{id}",
      "auth": "bearer",
      "headers": {
        "X-DashScope-Async": "enable"
      },
      "sources": [
        "https://help.aliyun.com/zh/model-studio/text-to-video-api-reference"
      ],
      "notes": "本协议对应 Wan 2.7；API Key 与地域须一致，可替换为工作空间专属域名。"
    },
    "runway": {
      "label": "Runway",
      "baseUrl": "https://api.dev.runwayml.com/v1",
      "createPath": "/text_to_video",
      "queryPath": "/tasks/{id}",
      "auth": "bearer",
      "headers": {
        "X-Runway-Version": "2024-11-06"
      },
      "sources": [
        "https://docs.dev.runwayml.com/api.md"
      ],
      "notes": "图生视频改用 /image_to_video；ratio 为像素比例，如 1280:720。"
    },
    "vidu": {
      "label": "Vidu",
      "baseUrl": "https://api.vidu.com/ent/v2",
      "createPath": "/text2video",
      "queryPath": "/tasks/{id}/creations",
      "auth": "token",
      "headers": {},
      "sources": [
        "https://platform.vidu.com/docs/text-to-video"
      ],
      "notes": "图生视频改用 /img2video；鉴权前缀是 Token。"
    },
    "luma": {
      "label": "Luma Agents Ray",
      "baseUrl": "https://agents.lumalabs.ai/v1",
      "createPath": "/generations",
      "queryPath": "/generations/{id}",
      "auth": "bearer",
      "headers": {},
      "sources": [
        "https://docs.agents.lumalabs.ai/guides/videos/migration/",
        "https://docs.agents.lumalabs.ai/guides/videos/generation/"
      ],
      "notes": "Ray 3.2 使用 Agents API 与新密钥，不使用旧 Dream Machine 协议。"
    },
    "kling": {
      "label": "Kling (API Key)",
      "baseUrl": "https://api-singapore.klingai.com",
      "createPath": "/text-to-video/{model}",
      "queryPath": "/tasks?task_ids={id}",
      "auth": "bearer",
      "headers": {},
      "sources": [
        "https://kling.ai/document-api/api/video/3-0-omni/text-to-video",
        "https://kling.ai/document-api/api/get-started/authentication",
        "https://kling.ai/document-api/api/video/3-0-turbo/image-to-video"
      ],
      "notes": "新版 API Key 协议；不使用旧版 AK/SK JWT。模型 ID 位于 URL 路径，输出配置位于 settings。"
    }
  },
